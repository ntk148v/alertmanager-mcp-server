# MCP configuration
MCP_TRANSPORT=stdio
# Used only if MCP_TRANSPORT is set to "http" or "sse"
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Optional bearer/API key for http/sse transports. When set, every request
# must present `Authorization: Bearer <value>` or be rejected with 401.
# Strongly recommended when the web transports are network-reachable.
# MCP_API_KEY=change-me

# Prometheus Alertmanager configuration
ALERTMANAGER_URL=http://localhost:9093
# Basic Auth Authentication Info
ALERTMANAGER_USERNAME=your_username
ALERTMANAGER_PASSWORD=your_password
